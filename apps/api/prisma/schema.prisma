// OpenBuild Gallery — data model for the seed product (the Poll clone).
// Design note on correctness-under-load: votes are an APPEND-ONLY table, and
// the tally is a COUNT over that table. There is no mutable counter to race on,
// so lost updates are impossible by construction. The two unique constraints on
// Vote enforce the two invariants candidates must not break:
//   - one vote per (poll, voter)      -> no double-vote across tabs
//   - one effect per idempotency key  -> safe client retries
// Concurrent writers that collide on either index lose with a unique violation,
// which the API translates into a clean 409 / idempotent replay — never a 500.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // one vote per voter per poll
  @@unique([pollId, voterId])
  // one effect per idempotency key, scoped to the poll (safe retries; keys are
  // meaningful within a poll, so two different polls can reuse a key name)
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

// Shortlink clone — append-only URL registry with concurrency-safe alias generation.
// Unique constraints enforce:
//   - one short code per generated value  -> no collisions from concurrent inserts
//   - one canonical mapping per (url, alias) -> safe retries; same input always resolves to same code
// Race conditions on insert are caught as P2002 and translated to 409/idempotent replay by the API layer.
model Shortlink {
  id        String   @id @default(cuid())
  url       String
  alias     String?
  code      String   @unique
  createdAt DateTime @default(now())

  @@unique([url, alias])
  @@index([code])
}
